{
  "$schema_version": "1.0.0",
  "description": "Canonical PII / clinical vocabulary shared across data-guard implementations (electric-elephant TS guard and CongoSky pii-firewall). Single source of truth so coverage cannot drift between repos. Terms are normalized: lower-case, spaces separate words (underscores/hyphens/camelCase are normalized to spaces at match time). Multi-word phrases match as a contiguous phrase; single tokens match on word boundaries.",
  "policy": {
    "hard_pii": "Never returnable / never sent to an external brain. Not overridable by any flag.",
    "clinical": "Health/clinical data (HL7v2, FHIR, LOINC, SNOMED, medical heuristics). Never overridable; every standard is always evaluated.",
    "overridable": "The ONLY class an explicit opt-in may release: the user's mobile/phone number (the Helium username).",
    "safe_name_prefixes": "Qualifiers that make a *_name column non-personal (e.g. table_name, username). A bare/other-prefixed name is personal and hard-excluded.",
    "medical_context_tokens": "Weak tokens (result/status/note) are only treated as clinical when paired with one of these context tokens."
  },
  "hard_pii": {
    "names": ["surname", "given name", "family name", "middle name", "maiden name", "first name", "last name", "full name", "next of kin", "emergency contact", "guardian name", "spouse name", "kin"],
    "contact": ["email", "email address", "fax"],
